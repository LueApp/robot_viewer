<?xml version="1.0"?>
<robot name="offline_xacro_demo" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="width" value="0.3"/>
  <link name="base_link"><visual><geometry><box size="${width} ${width} ${width}"/></geometry><material name="blue"><color rgba="0.15 0.4 0.9 1"/></material></visual></link>
  <link name="arm_link"><visual><origin xyz="0.3 0 0"/><geometry><box size="0.6 0.08 0.08"/></geometry></visual></link>
  <joint name="arm_joint" type="revolute"><parent link="base_link"/><child link="arm_link"/><origin xyz="0 0 0.2"/><axis xyz="0 0 1"/><limit lower="-1.57" upper="1.57" effort="10" velocity="1"/></joint>
</robot>
