<?xml version="1.0"?>
<robot name="joint_zero_demo">
  <!-- Set motor_joint's zero to 45 degrees: its 0..90 range becomes -45..45. -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.06"/>
      <geometry><box size="0.3 0.3 0.12"/></geometry>
      <material name="blue"><color rgba="0.12 0.35 0.75 1"/></material>
    </visual>
  </link>
  <link name="arm_link">
    <visual>
      <origin xyz="0.3 0 0"/>
      <geometry><box size="0.6 0.08 0.08"/></geometry>
      <material name="orange"><color rgba="0.95 0.42 0.12 1"/></material>
    </visual>
    <collision>
      <origin xyz="0.3 0 0"/>
      <geometry><box size="0.6 0.08 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.3 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.001067" ixy="0" ixz="0" iyy="0.030533" iyz="0" izz="0.030533"/>
    </inertial>
  </link>
  <joint name="motor_joint" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.5707963267948966" effort="20" velocity="2"/>
  </joint>
  <link name="tip_link">
    <visual>
      <geometry><sphere radius="0.065"/></geometry>
      <material name="green"><color rgba="0.18 0.72 0.42 1"/></material>
    </visual>
  </link>
  <joint name="tip_slide" type="prismatic">
    <origin xyz="0.6 0 0"/>
    <parent link="arm_link"/>
    <child link="tip_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.2" effort="5" velocity="0.5"/>
  </joint>
</robot>
