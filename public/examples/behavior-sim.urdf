<?xml version="1.0"?>
<robot name="behavior_sim_arm">
  <link name="base">
    <visual><geometry><cylinder radius="0.12" length="0.08"/></geometry><material name="base"><color rgba="0.2 0.3 0.4 1"/></material></visual>
  </link>
  <link name="upper_arm">
    <visual><origin xyz="0 0 0.2"/><geometry><box size="0.07 0.07 0.4"/></geometry><material name="upper"><color rgba="0.2 0.7 0.8 1"/></material></visual>
  </link>
  <joint name="shoulder_joint" type="revolute">
    <parent link="base"/><child link="upper_arm"/><origin xyz="0 0 0.08"/><axis xyz="0 1 0"/><limit lower="-2" upper="2" effort="10" velocity="10"/>
  </joint>
  <link name="forearm">
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.055 0.055 0.3"/></geometry><material name="forearm"><color rgba="0.9 0.6 0.2 1"/></material></visual>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0 0 0.4"/><axis xyz="0 1 0"/><limit lower="-2.5" upper="2.5" effort="10" velocity="10"/>
  </joint>
</robot>
